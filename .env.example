# Fincan environment · copy to .env and fill in.
# Public (bundled into the client build):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New-style publishable key (sb_publishable_...) — preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy JWT-format anon key also works (deprecated by end of 2026):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secrets (never expose):
# Supabase → Settings → Database → Connection string → "Pooler" (port 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-2.pooler.supabase.com:6543/postgres
# New-style secret key (sb_secret_...) or legacy service_role key; reserved
# for future server-side Supabase API needs (not used by app code today).
SUPABASE_SECRET_KEY=sb_secret_...
# Your production domain (informational)
DOMAIN_NAME=example.com